<div class="field"><label for="colore">Colori preferiti</label><select id="colore" name="colore"><option>Da concordare</option><option>Bianco e verde</option><option>Rosa e bianco</option><option>Rosso e bianco</option><option>Colori misti</option><option>Altro</option></select></div>
<div class="field"><label for="data">Data desiderata *</label><input id="data" name="data" type="date" required></div>
