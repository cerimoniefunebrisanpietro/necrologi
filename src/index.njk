<script>
(function(){
  const parts=new Intl.DateTimeFormat("en-GB",{timeZone:"Europe/Rome",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date());
  const date={};for(const p of parts)if(p.type!=="literal")date[p.type]=p.value;
  const today=date.year+"-"+date.month+"-"+date.day;
  let shown=0;
  document.querySelectorAll("[data-memory-date]").forEach(el=>{
    const original=el.getAttribute("data-memory-date")||"";
    const annual=el.getAttribute("data-memory-kind")==="annual";
    const sameDay=original.substring(5,10)===today.substring(5,10);
    const eligible=annual?(Number(date.year)>Number(original.substring(0,4))&&sameDay):(original===today);
    if(eligible){el.hidden=false;shown++;}
  });
  const empty=document.getElementById("memory-today-empty");
  if(empty)empty.hidden=shown>0;
})();
</script>
