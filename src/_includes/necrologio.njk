---
layout: base.njk
---

<main>

<section class="detail-hero">
  <div class="container">
    <a href="/necrologi/">← Torna ai necrologi</a>
  </div>
</section>

<section class="section detail-section">
  <div class="container">

    <div class="obit-detail">

      <div class="obit-photo-column">

        {% if foto %}
        <img
          class="portrait"
          src="{{ foto }}"
          alt="Foto di {{ nome_completo }}">
        {% endif %}

        <div class="qrbox">
          <h3>QR code del necrologio</h3>
          <div id="qrcode"></div>
          <p>Per manifesti, ricordini e condivisione.</p>

          <button
            class="btn btn-gold"
            id="downloadQr"
            type="button">
            Scarica QR
          </button>
        </div>

      </div>

      <article class="obit-paper">

        {% if archiviato %}
        <span class="badge">Necrologio archiviato</span>
        {% endif %}

        <p class="eyebrow eyebrow--dark">Nel ricordo</p>

        <h1>{{ nome_completo }}</h1>

        <div class="dates">
          {{ data_nascita | dateIt }}
          —
          {{ data_decesso | dateIt }}
        </div>

        <div class="gold-rule"></div>

        <div class="obit-text">
          {{ content | safe }}
        </div>

        <div class="info-grid">

          {% if rosario_data %}
          <div class="info">
            <strong>Santo Rosario</strong>
            {{ rosario_data | dateTimeIt }}
            {% if rosario_luogo %}
            <br>{{ rosario_luogo }}
            {% endif %}
          </div>
          {% endif %}

          {% if funerale_data %}
          <div class="info">
            <strong>Cerimonia funebre</strong>
            {{ funerale_data | dateTimeIt }}
            {% if funerale_luogo %}
            <br>{{ funerale_luogo }}
            {% endif %}
          </div>
          {% endif %}

          {% if destinazione %}
          <div class="info">
            <strong>Destinazione</strong>
            {{ destinazione }}
          </div>
          {% endif %}

          {% if note %}
          <div class="info">
            <strong>Informazioni</strong>
            {{ note }}
          </div>
          {% endif %}

        </div>

        <a class="btn btn-green" href="#condoglianze">
          Lascia un pensiero
        </a>

      </article>

    </div>

  </div>
</section>


<section
  id="condoglianze"
  class="section condolences-section">

  <div class="container">

    <div class="section-head">

      <p class="eyebrow eyebrow--dark">
        Condoglianze
      </p>

      <h2>Lascia un pensiero alla famiglia</h2>

      <div class="gold-rule gold-rule--center"></div>

      <p>
        Il messaggio viene verificato prima
        dell'eventuale pubblicazione.
      </p>

    </div>


    <div class="columns">

      <form
        class="form"
        name="condoglianze"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/grazie/">

        <input
          type="hidden"
          name="form-name"
          value="condoglianze">

        <input
          type="hidden"
          name="necrologio"
          value="{{ nome_completo }}">

        <input
          type="hidden"
          name="pagina"
          value="{{ page.url }}">

        <p style="display:none">
          <label>
            Non compilare:
            <input name="bot-field">
          </label>
        </p>


        <div class="row">

          <div class="group">
            <label>Nome e cognome *</label>
            <input name="nome" required>
          </div>

          <div class="group">
            <label>Email *</label>
            <input
              name="email"
              type="email"
              required>
          </div>

        </div>


        <div class="group">

          <label>Messaggio *</label>

          <textarea
            name="messaggio"
            maxlength="1500"
            required></textarea>

        </div>


        <div class="group check">

          <input
            id="pubblica"
            name="autorizza_pubblicazione"
            type="checkbox"
            value="sì">

          <label for="pubblica">
            Autorizzo la pubblicazione del messaggio
            senza mostrare la mia email.
          </label>

        </div>


        <div class="group check">

          <input
            id="privacy"
            name="privacy"
            type="checkbox"
            required>

          <label for="privacy">
            Acconsento al trattamento dei dati
            per l'invio della condoglianza. *
          </label>

        </div>


        <button
          class="btn btn-green"
          type="submit">

          Invia condoglianze

        </button>

      </form>


      <aside class="condolence-aside">

        <span>🕯</span>

        <h3>Un pensiero di vicinanza</h3>

        <p>
          Le parole possono essere un gesto semplice
          e prezioso per chi vive un momento di dolore.
        </p>

      </aside>

    </div>

  </div>
</section>

</main>


<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
const url = window.location.href.split('#')[0] + '#condoglianze';

const box = document.getElementById('qrcode');

if (box && window.QRCode) {
  new QRCode(box, {
    text: url,
    width: 220,
    height: 220,
    colorDark: '#063a2a',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.H
  });
}

const dl = document.getElementById('downloadQr');

if (dl) {
  dl.addEventListener('click', () => {

    const canvas = box.querySelector('canvas');
    const img = box.querySelector('img');

    const data = canvas
      ? canvas.toDataURL('image/png')
      : img.src;

    const a = document.createElement('a');

    a.href = data;
    a.download = 'qr-necrologio.png';

    a.click();
  });
}
</script>
