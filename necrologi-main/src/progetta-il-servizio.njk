<script>
(function(){const form=document.getElementById('planner'),total=document.getElementById('estimate'),summary=document.getElementById('summary'),send=document.getElementById('sendEstimate'),note=document.getElementById('note'),calculate=document.getElementById('calculateEstimate'),result=document.getElementById('estimateResult'),person=document.getElementById('personaServizio'),requester=document.getElementById('richiedente'),phone=document.getElementById('telefonoRichiedente'),servicesField=document.getElementById('serviziScelti'),estimateField=document.getElementById('stimaComplessiva');let whatsappUrl='';
function selected(){return [...form.querySelectorAll('input[data-price]:checked')]}
function refresh(){const items=selected();summary.innerHTML=items.length?'<ul>'+items.map(i=>'<li><span>'+i.dataset.name+'</span></li>').join('')+'</ul>':'<p>Seleziona le voci desiderate.</p>';result.hidden=true;calculate.hidden=false}
calculate.addEventListener('click',()=>{const items=selected(),amount=items.reduce((sum,input)=>sum+Number(input.dataset.price),0);if(!items.length){alert('Seleziona almeno un servizio.');return}total.textContent=new Intl.NumberFormat('it-IT',{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(amount);servicesField.value=items.map(i=>i.dataset.name).join('; ');estimateField.value=total.textContent;result.hidden=false;calculate.hidden=true;result.scrollIntoView({behavior:'smooth',block:'nearest'})});
form.addEventListener('submit',function(event){if(!form.reportValidity()){event.preventDefault();return}const items=selected();if(!items.length){event.preventDefault();alert('Seleziona almeno un servizio.');return}if(result.hidden){event.preventDefault();alert('Prima calcola la stima finale.');return}const lines=items.map(i=>'• '+i.dataset.name);let msg='Buongiorno, ho composto un servizio sul sito Cerimonie Funebri San Pietro.\n\nPersona per cui richiedo il servizio: '+person.value.trim()+'\nRichiedente: '+requester.value.trim()+'\nTelefono: '+phone.value.trim()+'\n\n'+lines.join('\n')+'\n\nStima complessiva indicativa: '+total.textContent;if(note.value.trim())msg+='\n\nAltre richieste: '+note.value.trim();msg+='\n\nVorrei richiedere un colloquio riservato e un preventivo definitivo.';whatsappUrl='https://wa.me/393272648122?text='+encodeURIComponent(msg);send.disabled=true;send.textContent='Invio in corso…';setTimeout(function(){window.location.href=whatsappUrl},700)});
form.addEventListener('change',function(event){if(event.target.matches('input[data-price]'))refresh()});note.addEventListener('input',function(){if(!result.hidden)refresh()});refresh()})();
</script>
